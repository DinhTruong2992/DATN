{
  "name": "datn-ecommerce",
  "version": "1.0.0",
  "description": "E-commerce website with Nike-style UI, authentication, payment, and shopping cart",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:demo": "DEMO_MODE=true nodemon server.js",
    "dev:db": "DEMO_MODE=false nodemon server.js",
    "prod": "NODE_ENV=production node server.js",
    "render-build": "npm install",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,ejs,css}\"",
    "audit-fix": "npm audit fix",
    "clean": "rm -rf node_modules package-lock.json",
    "clean-install": "npm run clean && npm install",
    "seed": "node scripts/seed.js",
    "seed:demo": "DEMO_MODE=true node scripts/seed.js"
  },
  "keywords": [
    "ecommerce",
    "nike",
    "authentication",
    "shopping-cart",
    "payment",
    "mongodb",
    "express",
    "nodejs"
  ],
  "author": "Truong",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DinhTruong2992/DATN.git"
  },
  "bugs": {
    "url": "https://github.com/DinhTruong2992/DATN/issues"
  },
  "homepage": "https://github.com/DinhTruong2992/DATN#readme",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-session": "^1.19.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^7.8.8",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "validator": "^13.11.0",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.51.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.28.1",
    "prettier": "^3.0.3"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ]
}