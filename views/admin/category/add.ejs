<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<title>Thêm danh mục</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<style>
body { background-color: #f4f6f9; }
.card { border-radius: 15px; }
.form-control:focus { box-shadow: none; border-color: #0d6efd; }
</style>
</head>
<body>
<div class="container mt-5 mb-5">
  <div class="card shadow p-4">
    <h3 class="mb-4">➕ Thêm Danh Mục Mới</h3>
    <!-- Form thêm danh mục -->
    <form method="POST" action="/admin/categories/add">
      <div class="mb-3">
        <label class="form-label">Tên danh mục</label>
        <input type="text" name="name" class="form-control" placeholder="Nhập tên danh mục" required>
      </div>
      <div class="text-end">
        <a href="/admin/categories" class="btn btn-secondary me-2">Hủy</a>
        <button type="submit" class="btn btn-success">Thêm danh mục</button>
      </div>
    </form>
  </div>
</div>
</body>
</html>