<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<title>Danh mục</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

</head>
<body class="container mt-5">

<h2>Quản lý Danh Mục</h2>

<a href="/admin/categories/add" class="btn btn-primary mb-3">Thêm danh mục</a>

<table class="table table-bordered">
<thead>
<tr>
<th>Tên danh mục</th>
<th>Hành động</th>
</tr>
</thead>

<tbody>

<% categories.forEach(cat => { %>

<tr>
<td><%= cat.name %></td>

<td>
<a href="/admin/categories/edit/<%= cat._id %>" class="btn btn-warning btn-sm">Sửa</a>

<a href="/admin/categories/delete/<%= cat._id %>" 
class="btn btn-danger btn-sm"
onclick="return confirm('Xóa danh mục?')">Xóa</a>
</td>

</tr>

<% }) %>

</tbody>
</table>

</body>
</html>