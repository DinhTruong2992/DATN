<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<title>Quản lý danh mục</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body class="container mt-5">

<h2>Quản lý Danh Mục</h2>

<a href="/admin/categories/add" class="btn btn-primary mb-3">
+ Thêm danh mục
</a>

<table class="table table-bordered table-hover">

<thead class="table-dark">

<tr>
<th>Tên danh mục</th>
<th>Trạng thái</th>
<th width="220">Hành động</th>
</tr>

</thead>

<tbody>

<% if(categories.length > 0){ %>

<% categories.forEach(cat => { %>

<tr>

<td>
<%= cat.name %>
</td>

<!-- STATUS -->
<td>

<% if(cat.status == 1){ %>

<span class="badge bg-success">
Hiển thị
</span>

<% } else { %>

<span class="badge bg-secondary">
Ẩn
</span>

<% } %>

</td>

<td>

<a href="/admin/categories/edit/<%= cat._id %>" 
class="btn btn-warning btn-sm">
Sửa
</a>

<a href="/admin/categories/delete/<%= cat._id %>" 
class="btn btn-danger btn-sm"
onclick="return confirm('Xóa danh mục?')">
Xóa
</a>

<a href="/admin/categories/toggle-status/<%= cat._id %>" 
class="btn btn-info btn-sm">
Ẩn / Hiện
</a>

</td>

</tr>

<% }) %>

<% } else { %>

<tr>
<td colspan="3" class="text-center text-muted">
Chưa có danh mục
</td>
</tr>

<% } %>

</tbody>

</table>

</body>
</html>