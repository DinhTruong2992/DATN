<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<title>Dashboard</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body class="bg-light">

<div class="container mt-4">

<h2 class="mb-4">📊 Admin Dashboard</h2>

<div class="row">

<div class="col-md-4">
<div class="card text-center shadow">
<div class="card-body">
<h5>📦 Tổng sản phẩm</h5>
<h3><%= productCount %></h3>
</div>
</div>
</div>

<div class="col-md-4">
<div class="card text-center shadow">
<div class="card-body">
<h5>📂 Tổng danh mục</h5>
<h3><%= categoryCount %></h3>
</div>
</div>
</div>

<div class="col-md-4">
<div class="card text-center shadow">
<div class="card-body">
<h5>👤 Tổng người dùng</h5>
<h3><%= userCount %></h3>
</div>
</div>
</div>

</div>

</div>

</body>
</html>