<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<title>Sửa sản phẩm</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
body { background-color:#f4f6f9; }

.card{
border-radius:20px;
}

.form-control:focus{
box-shadow:none;
border-color:#0d6efd;
}

.preview-img{
width:120px;
height:120px;
object-fit:cover;
border-radius:10px;
border:1px solid #ddd;
}
</style>

</head>

<body>

<div class="container mt-5 mb-5">

<div class="card shadow-lg p-4">

<h3 class="mb-4">✏️ Sửa sản phẩm</h3>

<form action="/admin/products/edit/<%= product._id %>" method="POST" enctype="multipart/form-data">

<div class="row">

<!-- TÊN -->
<div class="col-md-6 mb-3">
<label class="form-label">Tên sản phẩm</label>

<input
type="text"
name="name"
class="form-control"
value="<%= product.name %>"
required>
</div>

<!-- GIÁ -->
<div class="col-md-6 mb-3">
<label class="form-label">Giá (VNĐ)</label>

<input
type="number"
name="price"
class="form-control"
value="<%= product.price %>"
required>
</div>

<!-- DANH MỤC -->
<div class="col-md-6 mb-3">

<label class="form-label">Danh mục</label>

<select name="id_category" class="form-select" required>

<option value="">-- Chọn danh mục --</option>

<% categories.forEach(cat => { %>

<option
value="<%= cat._id %>"
<%= product.id_category && product.id_category.toString() === cat._id.toString() ? "selected" : "" %>
>

<%= cat.name %>

</option>

<% }) %>

</select>

</div>

<!-- SỐ LƯỢNG -->
<div class="col-md-6 mb-3">

<label class="form-label">Số lượng</label>

<input
type="number"
name="stock"
class="form-control"
value="<%= product.stock %>"
required>

</div>

<!-- ẢNH -->
<div class="col-md-6 mb-3">

<label class="form-label">Ảnh sản phẩm</label>

<input
type="file"
name="image"
class="form-control"
accept="image/*"
onchange="previewImage(event)">

</div>

<div class="col-md-6 mb-3 d-flex align-items-end">

<img
id="preview"
class="preview-img"
src="<%= product.image ? '/uploads/' + product.image : 'https://via.placeholder.com/120' %>">

</div>

<!-- MÔ TẢ -->
<div class="col-12 mb-3">

<label class="form-label">Mô tả sản phẩm</label>

<textarea
name="description"
rows="4"
class="form-control"><%= product.description %></textarea>

</div>

<!-- THÔNG SỐ -->
<!-- THÔNG SỐ -->
<div class="col-12 mb-3">

<label class="form-label">Thông số (JSON)</label>

<textarea
name="specifications"
rows="3"
class="form-control"><%= product.specifications ? JSON.stringify(product.specifications, null, 2) : "" %></textarea>

</div>

<!-- STATUS -->
<div class="col-md-6 mb-3">

<label class="form-label">Trạng thái</label>

<select name="status" class="form-select">

<option value="1" <%= product.status == 1 ? "selected" : "" %>>
Hiển thị
</option>

<option value="0" <%= product.status == 0 ? "selected" : "" %>>
Ẩn
</option>

</select>

</div>

</div>

<div class="text-end mt-3">

<a href="/admin/products" class="btn btn-secondary me-2">
Hủy
</a>

<button type="submit" class="btn btn-primary">
Cập nhật sản phẩm
</button>

</div>

</form>

</div>

</div>

<script>

function previewImage(event){

const reader = new FileReader();

reader.onload = function(){

document.getElementById('preview').src = reader.result;

}

reader.readAsDataURL(event.target.files[0]);

}

</script>

</body>
</html>