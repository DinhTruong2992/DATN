<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<title>Quản lý User</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body class="container mt-5">

<h2>Quản lý User</h2>

<a href="/admin/users/add" class="btn btn-primary mb-3">
  + Thêm User
</a>

<table class="table table-bordered table-hover">

<thead class="table-dark">
<tr>
<th>Username</th>
<th>Email</th>
<th>Role</th>
<th>Trạng thái</th>
<th width="220">Hành động</th>
</tr>
</thead>

<tbody>

<% if(users.length > 0){ %>
  <% users.forEach(user => { %>
    <tr>
      <td><%= user.username %></td>
      <td><%= user.email %></td>
      <td><%= user.role %></td>
      
      <!-- STATUS -->
      <td>
        <% if(user.status == 1){ %>
          <span class="badge bg-success">Hoạt động</span>
        <% } else { %>
          <span class="badge bg-secondary">Khóa</span>
        <% } %>
      </td>

      <td>
        <a href="/admin/users/edit/<%= user._id %>" class="btn btn-warning btn-sm">Sửa</a>
        <a href="/admin/users/delete/<%= user._id %>" class="btn btn-danger btn-sm" onclick="return confirm('Xóa user?')">Xóa</a>
        <!-- Đã sửa đường dẫn toggle đúng với router -->
        <a href="/admin/users/toggle/<%= user._id %>" class="btn btn-info btn-sm">Khóa / Mở</a>
      </td>
    </tr>
  <% }) %>
<% } else { %>
  <tr>
    <td colspan="5" class="text-center text-muted">
      Chưa có user
    </td>
  </tr>
<% } %>

</tbody>

</table>

</body>
</html>