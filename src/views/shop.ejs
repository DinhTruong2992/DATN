<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <title>Shop</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"> <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/layout.css">
    <style>
        body {
            background: #fff;
            margin: 0;
            height: 100vh;
            overflow: hidden;
        }

        /* Header */
        .shop-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            background: #fff;
            z-index: 1000;
        }

        .shop-header h4 {
            margin: 0;
            font-weight: 600;
        }

        .search-icon {
            font-size: 20px;
            cursor: pointer;
        }

        /* Tabs */
        .shop-tabs {
            display: flex;
            gap: 20px;
            padding: 0 16px;
            border-bottom: 1px solid #eee;
        }

        .shop-tab {
            padding-bottom: 10px;
            font-size: 14px;
            cursor: pointer;
            color: #888;
        }

        .shop-tab.active {
            color: #000;
            font-weight: 600;
            border-bottom: 2px solid #000;
        }

        .shop-tabs-wrapper {
            position: fixed;
            top: 64px;
            /* ngay dưới header */
            left: 0;
            right: 0;
            background: #fff;
            z-index: 999;
        }

        /* horizontal list */
        .category-section {
            padding: 16px;
        }

        .category-title {
            font-weight: 600;
            margin-bottom: 10px;
        }

        .horizontal-list {
            display: flex;
            gap: 12px;
            overflow-x: auto;
        }

        .horizontal-list::-webkit-scrollbar {
            display: none;
        }

        .product-card {
            min-width: 140px;
        }

        /* Search box */
        .search-box {
            display: none;
            padding: 0 16px 12px;
        }

        .search-box input {
            width: 100%;
            padding: 8px 12px;
            border-radius: 20px;
            border: 1px solid #ddd;
        }

        /* Shop-content */
        .shop-content {
            position: absolute;
            top: 112px;
            /* header (64) + tab (48) */
            bottom: 70px;
            /* bottom nav */
            left: 0;
            right: 0;
            overflow-y: auto;
        }
    </style>
</head>

<body> <!-- Header -->
    <div class="shop-header">
        <h4>Shop</h4>
        <div class="search-icon" onclick="toggleSearch()">🔍</div>
    </div>
    <div class="search-box" id="searchBox"> <input type="text" placeholder="Tìm kiếm sản phẩm..."
            onkeyup="searchProduct(this.value)"> </div>
    <div class="shop-tabs-wrapper">
        <div class="shop-tabs">
            <div class="shop-tab active" data-target="robot">Robot</div>
            <div class="shop-tab" data-target="gau-bong">Thú bông</div>
            <div class="shop-tab" data-target="game">game</div>
        </div>
    </div> <!-- Search -->
    <div class="shop-content"> <!-- Tabs -->
        <% productsByCategory.forEach(cat=> { %> <div class="category-section" id="<%= cat.slug %>">
                <div class="category-title">
                    <%= cat.name %>
                </div>
                <div class="horizontal-list">
                    <% cat.products.forEach(p=> { %> <div class="product-card"> <img src="<%= p.image %>">
                            <div class="product-name">
                                <%= p.name %>
                            </div>
                            <div class="product-price">
                                <%= p.price.toLocaleString('vi-VN') %>₫
                            </div>
                        </div>
                        <% }) %>
                </div>
            </div>
            <% }) %>
                <script> function toggleSearch() {
                        const box = document.getElementById('searchBox');
                        box.style.display = box.style.display === 'block' ? 'none' : 'block';
                    }
                    function searchProduct(keyword) {
                        keyword = keyword.toLowerCase();
                        const products = document.querySelectorAll('.product-card');
                        products.forEach(p => {
                            const name = p.dataset.name.toLowerCase();
                            p.style.display = name.includes(keyword) ? 'block' : 'none';
                        });
                    } 
                </script>
                <!-- Chuyen tab -->
                <script> const headerHeight = 112; const TAB_OFFSET = 16;
                    document.querySelectorAll('.shop-tab').forEach(tab => {
                        tab.addEventListener('click', () => {
                            const targetId = tab.dataset.target;
                            const section = document.getElementById(targetId);
                            if (section) {
                                const container = document.querySelector('.shop-content');
                                const offsetTop = section.offsetTop; container.scrollTo({
                                    top: offsetTop - TAB_OFFSET, behavior: 'smooth'
                                });
                            }
                            document.querySelectorAll('.shop-tab').forEach(t => t.classList.remove('active'));
                            tab.classList.add('active');
                        });
                    });

                </script>
                <!-- Bottom Navigation --> <%- include('partials/bottom-nav', { active: 'shop' }) %>
</body>

</html>