<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <title>Thanh toán</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="layout.css">

    <style>
        body {
            background: #f5f5f5;
            margin: 0;
            font-family: sans-serif;
            padding-bottom: 90px;
        }

        .page-wrapper {
            padding: 15px;
        }

        .section {
            background: white;
            border-radius: 15px;
            padding: 15px;
            margin-top: 15px;
        }

        .product-item {
            display: flex;
            align-items: center;
            margin-bottom: 12px;
        }

        .product-item img {
            width: 70px;
            height: 70px;
            object-fit: contain;
            border-radius: 10px;
            background: #fff;
            padding: 5px;
        }

        .product-info {
            flex: 1;
            margin-left: 10px;
        }

        .price {
            color: red;
            font-weight: bold;
        }

        .total {
            font-size: 18px;
            font-weight: bold;
            color: red;
        }

        .btn-order {
            background: #d5001c;
            color: white;
            border-radius: 30px;
            padding: 15px;
            width: 100%;
            border: none;
            font-size: 16px;
            font-weight: 600;
        }

        .btn-order:active {
            transform: scale(0.97);
            opacity: 0.9;
        }

        .form-control {
            border-radius: 12px;
        }

        .payment-method label {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px;
            border-radius: 12px;
            border: 1px solid #eee;
            margin-bottom: 10px;
            cursor: pointer;
        }

        .payment-method input {
            accent-color: #d5001c;
        }
    </style>
</head>

<body>

    <div class="page-wrapper">

        <!-- ĐỊA CHỈ GIAO HÀNG -->
        <div class="section">
            <h6>📍 Địa chỉ giao hàng</h6>
            <input type="text" class="form-control mb-2" placeholder="Họ và tên" value="<%= user.name %>">
            <input type="text" class="form-control mb-2" placeholder="Số điện thoại" value="<%= user.phone %>">
            <input type="text" class="form-control" placeholder="Địa chỉ nhận hàng">
        </div>

        <!-- SẢN PHẨM -->
        <div class="section">
            <h6>🛒 Sản phẩm</h6>

            <% cart.items.forEach(item => { %>
                <div class="product-item">
                    <img src="<%= item.product.image %>">
                    <div class="product-info">
                        <div><%= item.product.name %></div>
                        <small>Số lượng: <%= item.quantity %></small>
                    </div>
                    <div class="price">
                        <%= (item.product.price * item.quantity).toLocaleString("vi-VN") %>₫
                    </div>
                </div>
            <% }) %>
        </div>

        <!-- PHƯƠNG THỨC THANH TOÁN -->
        <div class="section">
            <h6>💳 Phương thức thanh toán</h6>

            <div class="payment-method">
                <label>
                    <input type="radio" name="payment" checked>
                    Thanh toán khi nhận hàng (COD)
                </label>

                <label>
                    <input type="radio" name="payment">
                    Ví MoMo
                </label>

                <label>
                    <input type="radio" name="payment">
                    Chuyển khoản ngân hàng
                </label>
            </div>
        </div>

        <!-- TỔNG TIỀN -->
        <div class="section">
            <div class="d-flex justify-content-between">
                <span>Tạm tính</span>
                <span><%= cart.totalPrice.toLocaleString("vi-VN") %>₫</span>
            </div>

            <div class="d-flex justify-content-between mt-2">
                <span>Phí vận chuyển</span>
                <span>0₫</span>
            </div>

            <hr>

            <div class="d-flex justify-content-between">
                <span>Tổng cộng</span>
                <span class="total"><%= cart.totalPrice.toLocaleString("vi-VN") %>₫</span>
            </div>
        </div>

        <!-- ĐẶT HÀNG -->
        <button class="btn-order mt-3" onclick="placeOrder()">
            ĐẶT HÀNG
        </button>

    </div>

    <script>
        async function placeOrder() {
            try {
                const res = await fetch("/order/create", {
                    method: "POST",
                    credentials: "same-origin"
                });

                const data = await res.json();

                if (data.success) {
                    window.location.href = "/order/success";
                } else {
                    alert("❌ Đặt hàng thất bại");
                }
            } catch (err) {
                console.error(err);
                alert("❌ Lỗi hệ thống");
            }
        }
    </script>

    <%- include('partials/bottom-nav', { active: 'cart' }) %>

</body>

</html>
