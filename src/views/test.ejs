<body>
    <div class="register-container">
        <div class="header"> <img src="/images/UI/logo.jpg" alt="Logo" class="logo">
            <h1 class="title">Tạo tài khoản</h1>
            <p class="subtitle">Tham gia cùng chúng tôi ngay hôm nay</p>
        </div> <!-- Phần quay lại trang chủ --> <a href="/splash" class="back-link">Quay lại trang chủ</a>
        <% if (message) { %>
            <div class="alert alert-<%= message.type %>">
                <%= message.text %>
            </div>
            <% } %>
                <form id="registerForm">
                    <div class="form-group"> <label for="username" class="form-label">Tên đăng nhập *</label> <input
                            type="text" class="form-control" id="username" name="username"
                            placeholder="Nhập tên đăng nhập (3-30 ký tự)" minlength="3" maxlength="30"
                            pattern="[a-zA-Z0-9_]+" required> <span class="form-text">Chỉ cho phép chữ cái, số và dấu
                            gạch dưới</span> <span class="error-message" id="usernameError"></span> </div>
                    <div class="form-group"> <label for="email" class="form-label">Email *</label> <input type="email"
                            class="form-control" id="email" name="email" placeholder="Nhập email của bạn" required>
                        <span class="error-message" id="emailError"></span>
                    </div>
                    <div class="form-group"> <label for="phoneNumber" class="form-label">Số điện thoại *</label> <input
                            type="tel" class="form-control" id="phoneNumber" name="phoneNumber"
                            placeholder="Nhập số điện thoại (10-11 chữ số)" pattern="[0-9]{10,11}" required> <span
                            class="form-text">Chỉ 10-11 chữ số</span> <span class="error-message"
                            id="phoneError"></span> </div>
                    <div class="form-group"> <label for="password" class="form-label">Mật khẩu *</label>
                        <div class="password-wrapper"> <input type="password" class="form-control" id="password"
                                name="password" placeholder="Nhập mật khẩu" minlength="8" maxlength="16" required>
                            <button type="button" class="password-toggle" onclick="togglePassword('password')"> <img
                                    src="/images/UI/hide.jpg" alt="Toggle"> </button>
                        </div>
                        <div class="requirements" style="margin-top: 10px;">
                            <div class="requirement" id="reqLength"> <span style="margin-right: 8px;">•</span> <span
                                    style="font-size: 12px; color: #999;">8-16 ký tự</span> </div>
                            <div class="requirement" id="reqUppercase"> <span style="margin-right: 8px;">•</span> <span
                                    style="font-size: 12px; color: #999;">Ít nhất một chữ hoa</span> </div>
                            <div class="requirement" id="reqSpecial"> <span style="margin-right: 8px;">•</span> <span
                                    style="font-size: 12px; color: #999;">Ít nhất một ký tự đặc biệt
                                    (!@#$%^&*...)</span> </div>
                        </div> <span class="error-message" id="passwordError"></span>
                    </div>
                    <div class="form-group"> <label for="confirmPassword" class="form-label">Xác nhận mật khẩu *</label>
                        <div class="password-wrapper"> <input type="password" class="form-control" id="confirmPassword"
                                name="confirmPassword" placeholder="Xác nhận mật khẩu của bạn" required> <button
                                type="button" class="password-toggle" onclick="togglePassword('confirmPassword')"> <img
                                    src="/images/UI/hide.jpg" alt="Toggle"> </button> </div> <span class="error-message"
                            id="confirmPasswordError"></span>
                    </div>
                    
                    
                    <div class="terms"> <label> <input type="checkbox" id="emailUpdates"> <span>Đăng ký nhận email để
                                cập nhật thông tin sản phẩm, ưu đãi và quyền lợi thành viên</span> </label> <label
                            style="margin-top: 10px;"> <input type="checkbox" id="agreeTerms" required> <span>Tôi đồng ý
                                với <a href="#">Chính sách bảo mật</a> và <a href="#">Điều khoản sử dụng</a></span>
                        </label> <span class="error-message" id="termsError"></span> </div> <button type="submit"
                        class="btn-register" id="submitBtn"> Tạo tài khoản </button>
                </form>
                <div class="links"> <a href="/login">Đã có tài khoản? Đăng nhập</a> </div>
    </div>
    <script>
        const passwordStates = {
            password: false,
            confirmPassword: false
        };

        function togglePassword(fieldId) {
            const input = document.getElementById(fieldId);
            const wrapper = input.closest('.password-wrapper');
            const icon = wrapper.querySelector('.password-toggle img');

            passwordStates[fieldId] = !passwordStates[fieldId];

            input.type = passwordStates[fieldId] ? 'text' : 'password';
            icon.src = passwordStates[fieldId]
                ? '/images/UI/show.jpg'
                : '/images/UI/hide.jpg';
        }
    </script>


    <script>
        // Biến lưu trạng thái hiển thị mật khẩu 
        
        // Xác thực mật khẩu 
        const passwordInput = document.getElementById('password');
        const confirmPasswordInput = document.getElementById('confirmPassword');
        const requirements = {
            length: document.getElementById('reqLength'),
            uppercase: document.getElementById('reqUppercase'),
            special: document.getElementById('reqSpecial')
        };

        passwordInput.addEventListener('input', function () {
            validatePassword(); validateConfirmPassword();
        });
        confirmPasswordInput.addEventListener('input', validateConfirmPassword);
        function validatePassword() {
            const password = passwordInput.value; let isValid = true;
            // Kiểm tra độ dài 
            const isValidLength = password.length >= 8
                && password.length <= 16;
            updateRequirement(requirements.length, isValidLength);
            if (!isValidLength) isValid = false;
            // Kiểm tra chữ hoa 
            const hasUppercase = /[A-Z]/.test(password);
            updateRequirement(requirements.uppercase, hasUppercase);
            if (!hasUppercase) isValid = false;
            // Kiểm tra ký tự đặc biệt 
            const hasSpecial = /[!@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]/.test(password);
            updateRequirement(requirements.special, hasSpecial);
            if (!hasSpecial) isValid = false;
            return isValid;
        }
        function validateConfirmPassword() {
            const password = passwordInput.value;
            const confirmPassword = confirmPasswordInput.value;
            const errorElement = document.getElementById('confirmPasswordError');
            if (confirmPassword && password !== confirmPassword) {
                errorElement.textContent = 'Mật khẩu không khớp';
                errorElement.classList.add('show-error');
                confirmPasswordInput.classList.add('is-invalid');
                return false;
            }
            else {
                errorElement.textContent = ''; errorElement.classList.remove('show-error');
                confirmPasswordInput.classList.remove('is-invalid'); return true;
            }
        }
        function updateRequirement(element, isValid) {
            const icon = element.querySelector('span:first-child');
            const text = element.querySelector('span:last-child');
            if (isValid) {
                icon.textContent = '✓';
                icon.style.color = '#28a745';
                text.style.color = '#28a745';

            }
            else {
                icon.textContent = '•';
                icon.style.color = '#999';
                text.style.color = '#999';
            }
        }
        // Xử lý submit form 
        document.getElementById('registerForm').addEventListener('submit', async function (e) {
            e.preventDefault();
            // Reset lỗi 
            resetErrors();
            // Kiểm tra điều khoản 
            if (!document.getElementById('agreeTerms').checked) {
                showError('termsError', 'Vui lòng đồng ý với điều khoản sử dụng'); return;
            }
            // Kiểm tra mật khẩu 
            if (!validatePassword()) {
                showError('passwordError',
                    'Mật khẩu phải đáp ứng tất cả yêu cầu');
                return;
            }
            // Kiểm tra xác nhận mật khẩu 
            if (!validateConfirmPassword()) { return; }

            // // Chuẩn bị dữ liệu 
            const formData = {
                username: document.getElementById('username').value.trim(),
                email: document.getElementById('email').value.trim(),
                phoneNumber: document.getElementById('phoneNumber').value.trim(),
                password: passwordInput.value,

                emailUpdates: document.getElementById('emailUpdates').checked
            };
            // Hiển thị loading 
            const submitBtn = document.getElementById('submitBtn'); const originalText = submitBtn.innerHTML;
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="loading"></span> Đang xử lý...';
            try {
                const response = await fetch('/api/auth/register',
                    {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(formData)
                    });
                const result = await response.json();
                if (result.success) {
                    showMessage('Đăng ký thành công! Đang chuyển hướng...', 'success');
                    // Chuyển hướng sau 2 giây 
                    setTimeout(() => {
                        window.location.href = '/login?registered=true';
                    }, 2000);
                }
                else {
                    showMessage(result.message || 'Đăng ký thất bại', 'danger');
                    // Hiển thị lỗi cụ thể 
                    if (result.errors) {
                        result.errors.forEach(error => {
                            showError(error.field + 'Error', error.message);
                        });
                    }
                }
            } catch (error) {
                console.error('Registration error:', error);
                showMessage('Đã xảy ra lỗi. Vui lòng thử lại.', 'danger');
            } finally {
                // Khôi phục button
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
            }
        });

        function resetErrors() {
            document.querySelectorAll('.error-message').forEach(el => {
                el.textContent = '';
                el.classList.remove('show-error');
            });
            document.querySelectorAll('.is-invalid').forEach(el => {
                el.classList.remove('is-invalid');
            });
        }
        function showError(fieldId, message) {
            const errorElement = document.getElementById(fieldId);
            errorElement.textContent = message;
            errorElement.classList.add('show-error');
            // Thêm class is-invalid cho input tương ứng 
            const inputId = fieldId.replace('Error', '');
            const input = document.getElementById(inputId);
            if (input) {
                input.classList.add('is-invalid');
            }
        }
        function showMessage(text, type) {
            // Xóa thông báo cũ 
            const existingAlert = document.querySelector('.alert');
            if (existingAlert) { existingAlert.remove(); }
            // Tạo thông báo mới 
            const alertDiv = document.createElement('div');
            alertDiv.className = `alert alert-${type}`;
            alertDiv.textContent = text;
            // Thêm vào container 
            const container = document.querySelector('.register-container');
            const backLink = container.querySelector('.back-link');
            container.insertBefore(alertDiv, backLink.nextSibling);
            // Tự động xóa sau 5 giây 
            setTimeout(() => {
                if (alertDiv.parentNode) {
                    alertDiv.remove();
                }
            }, 5000);
        } </script>
    </script>
</body>

</html>