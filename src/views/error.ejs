<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error - DATN</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container py-5">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h3 class="mb-0">⚠️ Something went wrong</h3>
            </div>
            <div class="card-body">
                <h4 class="text-danger"><%= message %></h4>
                
                <% if (demoMode) { %>
                    <div class="alert alert-info mt-3">
                        <h5>📱 DEMO MODE ACTIVE</h5>
                        <p>This is a demonstration environment. Some features may be limited.</p>
                    </div>
                <% } %>
                
                <% if (error && Object.keys(error).length > 0) { %>
                    <div class="mt-4">
                        <h5>Technical Details:</h5>
                        <pre class="bg-dark text-light p-3 rounded"><%= JSON.stringify(error, null, 2) %></pre>
                    </div>
                <% } %>
                
                <div class="mt-4">
                    <a href="/" class="btn btn-primary">← Back to Home</a>
                    <a href="/status" class="btn btn-outline-secondary ms-2">System Status</a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>