<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Thanh toán</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/layout.css">

    <style>
        body {
            background: #f6f6f6;
            padding-bottom: 70px;
        }

        .card-box {
            background: #fff;
            border-radius: 14px;
            padding: 14px;
            margin-bottom: 16px;
        }

        .section-title {
            font-weight: 600;
            margin-bottom: 10px;
        }

        .payment-method {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px solid #eee;
        }

        .payment-method:last-child {
            border-bottom: none;
        }

        .total {
            font-size: 18px;
            font-weight: 700;
            color: #f44336;
        }

        .btn-pay {
            width: 100%;
            padding: 12px;
            border-radius: 10px;
            background: #ff9800;
            border: none;
            color: #fff;
            font-weight: 600;
        }
    </style>
</head>

<body>

<div class="container mt-4">

    <!-- HEADER -->
    <div class="text-center mb-3">
        <h5>Thanh toán</h5>
        <small class="text-muted">Xác nhận đơn hàng của bạn</small>
    </div>

    <!-- ORDER INFO -->
    <div class="card-box">
        <div class="section-title">Thông tin đơn hàng</div>
        <p>🧸 Gấu bông Teddy</p>
        <p>Số lượng: 1</p>
        <p>Giá: 250.000đ</p>
    </div>

    <!-- PAYMENT METHOD -->
    <div class="card-box">
        <div class="section-title">Phương thức thanh toán</div>

        <label class="payment-method">
            <span>💵 Thanh toán khi nhận hàng (COD)</span>
            <input type="radio" name="payment" checked>
        </label>

        <label class="payment-method">
            <span>🏦 Chuyển khoản ngân hàng</span>
            <input type="radio" name="payment">
        </label>

        <label class="payment-method">
            <span>💳 Ví điện tử (Momo)</span>
            <input type="radio" name="payment">
        </label>
    </div>

    <!-- TOTAL -->
    <div class="card-box d-flex justify-content-between align-items-center">
        <span>Tổng thanh toán</span>
        <span class="total">250.000đ</span>
    </div>

    <!-- PAY BUTTON -->
    <button class="btn-pay" onclick="submitPayment()">
        Xác nhận thanh toán
    </button>

</div>

<script>
    function submitPayment() {
        alert("Thanh toán thành công (demo) ✅");
        window.location.href = "/orders";
    }
</script>

<!-- BOTTOM NAV -->
<%- include('partials/bottom-nav', { active: 'payment' }) %>

</body>
</html>
