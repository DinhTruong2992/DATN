<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <title>Tài khoản</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/layout.css">

    <style>
        body {
            background: #f6f6f6;
            padding-bottom: 70px;
        }

        .avatar {
            width: 90px;
            height: 90px;
            border-radius: 50%;
            background: #ffecb3;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 36px;
            margin: auto;
        }

        .card-box {
            background: #fff;
            border-radius: 14px;
            padding: 12px;
            margin-bottom: 16px;
        }

        .quick-item {
            text-align: center;
            font-size: 13px;
        }

        .quick-item span {
            font-size: 24px;
            display: block;
            margin-bottom: 4px;
        }

        .list-group-item {
            border: none;
            border-bottom: 1px solid #eee;
        }

        .list-group-item:last-child {
            border-bottom: none;
        }

        .logout {
            color: #f44336;
            font-weight: 600;
        }
    </style>
</head>

<body>

    <div class="container mt-4">

        <!-- PROFILE -->
        <div class="text-center">
            <div class="avatar">🧸</div>
            <h6 class="mt-2 mb-1">
                <%= user?.username || 'Người dùng' %>
            </h6>
            <a href="/profile/edit" class="btn btn-outline-warning btn-sm">
                Chỉnh sửa hồ sơ
            </a>
        </div>

        <!-- QUICK ACTION -->
        <div class="card-box mt-4">
            <div class="row">
                <div class="col quick-item">
                    <span>📦</span>
                    <a href="/orders" class="text-decoration-none text-dark">
                        Đơn hàng
                    </a>
                </div>
                <div class="col quick-item">
                    <span>💳</span>
                    <a href="/payments" class="text-decoration-none text-dark">
                        Thanh toán
                    </a>
                </div>
                <div class="col quick-item">
                    <span>❤️</span>
                    <a href="/favorite" class="text-decoration-none text-dark">
                        Yêu thích
                    </a>
                </div>
                <div class="col quick-item">
                    <span>⚙️</span>
                    <a href="/settings" class="text-decoration-none text-dark">
                        Cài đặt
                    </a>
                </div>
            </div>
        </div>

        <!-- ACCOUNT -->
        <div class="card-box">
            <div class="list-group list-group-flush">
                <a href="/profile" class="list-group-item d-flex justify-content-between">
                    Thông tin cá nhân <span>›</span>
                </a>
                <a href="/change-password" class="list-group-item d-flex justify-content-between">
                    Đổi mật khẩu <span>›</span>
                </a>
                <a href="/logout" class="list-group-item d-flex justify-content-between logout">
                    Đăng xuất <span>›</span>
                </a>
            </div>
        </div>

        <!-- ORDER -->
        <div class="card-box">
            <div class="list-group list-group-flush">
                <a href="/orders" class="list-group-item d-flex justify-content-between">
                    Đơn hàng của tôi <span>›</span>
                </a>
                <a href="/payments" class="list-group-item d-flex justify-content-between">
                    Lịch sử thanh toán <span>›</span>
                </a>
            </div>
        </div>

    </div>

    <!-- BOTTOM NAV -->
    <%- include('partials/bottom-nav', { active: 'profile' }) %>

</body>

</html>





</body>

</html>