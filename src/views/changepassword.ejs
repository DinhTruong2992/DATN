<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đổi Mật Khẩu</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
        }
        .change-password-container {
            max-width: 500px;
            margin: 50px auto;
            padding: 30px;
            background-color: white;
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
        }
        .password-requirements {
            font-size: 0.9em;
            color: #666;
            margin-top: 5px;
        }
        .requirement {
            display: flex;
            align-items: center;
            margin-bottom: 3px;
        }
        .requirement.valid { color: green; }
        .requirement.invalid { color: red; }
        .requirement-icon {
            margin-right: 8px;
            font-size: 1.2em;
        }
    </style>
</head>
<body>

<div class="container">
    <div class="change-password-container">
        <h2 class="text-center mb-4">Đổi Mật Khẩu</h2>

        <form id="changePasswordForm">

            <!-- Mật khẩu hiện tại -->
            <div class="mb-3">
                <label class="form-label">Mật khẩu hiện tại *</label>
                <input type="password" class="form-control" id="currentPassword" required>
                <div class="invalid-feedback" id="currentPasswordError"></div>
            </div>

            <!-- Mật khẩu mới -->
            <div class="mb-3">
                <label class="form-label">Mật khẩu mới *</label>
                <input type="password" class="form-control" id="newPassword" required minlength="8" maxlength="16">

                <div class="password-requirements">
                    <div class="requirement" id="reqLength">
                        <span class="requirement-icon">•</span> 8–16 ký tự
                    </div>
                    <div class="requirement" id="reqUppercase">
                        <span class="requirement-icon">•</span> Ít nhất 1 chữ hoa
                    </div>
                    <div class="requirement" id="reqSpecial">
                        <span class="requirement-icon">•</span> Ít nhất 1 ký tự đặc biệt
                    </div>
                </div>

                <div class="invalid-feedback" id="newPasswordError"></div>
            </div>

            <!-- Xác nhận mật khẩu -->
            <div class="mb-3">
                <label class="form-label">Xác nhận mật khẩu mới *</label>
                <input type="password" class="form-control" id="confirmPassword" required>
                <div class="invalid-feedback" id="confirmPasswordError"></div>
            </div>

            <div class="d-grid">
                <button class="btn btn-primary btn-lg" type="submit" id="changeBtn">
                    Đổi mật khẩu
                </button>
            </div>
        </form>

        <div id="message" class="mt-3"></div>
    </div>
</div>

<script>
    const currentPasswordInput = document.getElementById("currentPassword");
    const newPasswordInput = document.getElementById("newPassword");
    const confirmPasswordInput = document.getElementById("confirmPassword");

    const requirements = {
        length: document.getElementById("reqLength"),
        uppercase: document.getElementById("reqUppercase"),
        special: document.getElementById("reqSpecial")
    };

    // realtime check mật khẩu mới
    newPasswordInput.addEventListener("input", function () {
        const password = this.value;

        update(requirements.length, password.length >= 8 && password.length <= 16);
        update(requirements.uppercase, /[A-Z]/.test(password));
        update(requirements.special, /[!@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]/.test(password));

        // ❌ trùng mật khẩu cũ
        if (currentPasswordInput.value && password === currentPasswordInput.value) {
            newPasswordInput.classList.add("is-invalid");
            document.getElementById("newPasswordError").textContent =
                "Mật khẩu mới không được trùng mật khẩu hiện tại";
        } else {
            newPasswordInput.classList.remove("is-invalid");
            document.getElementById("newPasswordError").textContent = "";
        }

        if (confirmPasswordInput.value) validateConfirmPassword();
    });

    confirmPasswordInput.addEventListener("input", validateConfirmPassword);

    function update(el, valid) {
        el.classList.toggle("valid", valid);
        el.classList.toggle("invalid", !valid);
        el.querySelector(".requirement-icon").textContent = valid ? "✓" : "•";
    }

    function validateConfirmPassword() {
        if (newPasswordInput.value !== confirmPasswordInput.value) {
            confirmPasswordInput.classList.add("is-invalid");
            document.getElementById("confirmPasswordError").textContent = "Mật khẩu không khớp";
            return false;
        }
        confirmPasswordInput.classList.remove("is-invalid");
        document.getElementById("confirmPasswordError").textContent = "";
        return true;
    }

    document.getElementById("changePasswordForm").addEventListener("submit", async function (e) {
        e.preventDefault();

        document.querySelectorAll(".is-invalid").forEach(el => el.classList.remove("is-invalid"));
        document.querySelectorAll(".invalid-feedback").forEach(el => el.textContent = "");

        const currentPassword = currentPasswordInput.value;
        const newPassword = newPasswordInput.value;

        // ❌ mật khẩu mới trùng mật khẩu cũ
        if (newPassword === currentPassword) {
            newPasswordInput.classList.add("is-invalid");
            document.getElementById("newPasswordError").textContent =
                "Mật khẩu mới không được trùng mật khẩu hiện tại";
            return;
        }

        // check độ mạnh
        if (
            newPassword.length < 8 ||
            !/[A-Z]/.test(newPassword) ||
            !/[!@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]/.test(newPassword)
        ) {
            newPasswordInput.classList.add("is-invalid");
            document.getElementById("newPasswordError").textContent = "Mật khẩu chưa đủ mạnh";
            return;
        }

        if (!validateConfirmPassword()) return;

        const btn = document.getElementById("changeBtn");
        btn.disabled = true;
        btn.textContent = "Đang xử lý...";

        try {
 const res = await fetch("/api/auth/change-password", {
  method: "PATCH",
  headers: {
    "Content-Type": "application/json",
    "Authorization": "Bearer YOUR_TOKEN"
  },
  body: JSON.stringify({ currentPassword, newPassword })
});


            const result = await res.json();

            if (result.success) {
                document.getElementById("message").innerHTML =
                    `<div class="alert alert-success">Đổi mật khẩu thành công!</div>`;
                document.getElementById("changePasswordForm").reset();
            } else {
                document.getElementById("message").innerHTML =
                    `<div class="alert alert-danger">${result.message}</div>`;
            }
        } catch {
            document.getElementById("message").innerHTML =
                `<div class="alert alert-danger">Lỗi kết nối server</div>`;
        } finally {
            btn.disabled = false;
            btn.textContent = "Đổi mật khẩu";
        }
    });
</script>

</body>
</html>
