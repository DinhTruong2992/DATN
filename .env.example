# ==================== DATN PROJECT ====================
# ENVIRONMENT TEMPLATE
# Copy to .env and fill your values
# ======================================================

# ========== APPLICATION ==========
PORT=3000
NODE_ENV=development
HOST=http://localhost:3000
CLIENT_URL=http://localhost:5500
DEMO_MODE=true

# ========== AUTHENTICATION ==========
JWT_SECRET=change_this_to_a_strong_random_secret_key
JWT_EXPIRE=7d
SESSION_SECRET=another_strong_random_secret

# ========== DATABASE ==========
# For MongoDB Atlas (Production):
# MONGODB_URI=mmongodb+srv://leader:c8KnvzS4bkuEYAcD@cluster0.xxxxx.mongodb.net/toy_store

# For Local MongoDB (Development):
# MONGODB_URI=mongodb://localhost:27017/datn_dev

# ========== EMAIL ==========
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_password_here

# ========== SECURITY ==========
CORS_ORIGIN=http://localhost:5500
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100